package ffi

// Foreign function bound via C ABI (implemented in C or Rust `extern "C"`).
extern fn c_add(a: i32, b: i32): i32

var x: i32 = 39
const y: i32 = 42

pri fn add_internal(a: i32, b: i32): i32
    var z: i32 = c_add(a, b)
    ret z
end

pub fn main(): i32
    print(add_internal(x, y))
    ret 0
end
