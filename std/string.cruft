package string

// String is a buffer {bytes, length, capacity, refcount}.
// Literals point at static bytes (they are not freed). `alloc_string(n)`
// asks the runtime for n+1 bytes through cruft_alloc and owns that block
// until the value is dropped, which calls cruft_free.
// `str` is the same type as String: a borrowed view is just a use that does
// not move the owner. `.data()` stays valid while that value is alive.
// `.length()` and `.byte_len()` are both the byte count as i64.

pub fn len(s: str): i64
    ret s.length()
end

pub fn byte_len(s: str): i64
    ret s.byte_len()
end

pub fn bytes(s: str): ptr
    unsafe
        ret s.data()
    end
end
