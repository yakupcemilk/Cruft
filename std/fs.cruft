package fs

import result

// Filesystem module. The loader finds this file as std/fs.cruft when a
// program `import fs`. Package names are a single identifier, same as `mem`.
//
// The externs are a fixed-width C ABI over fopen, fread, fwrite, fseek,
// ftell and fclose. Offsets are i64 so LLP64 `long` does not truncate a
// file past 2 GiB. `ptr` is an untyped C pointer; `null()` is the null pointer.
// String literals and `alloc_string` are NUL-terminated, so `.data()` is a
// C string for as long as the String value is alive.
//
// `File` owns the FILE*. Its `drop` calls `cruft_fclose`. `write_file` and
// `read_to_string` do not close the handle themselves.

extern fn cruft_fopen(path: ptr, mode: ptr): ptr
extern fn cruft_fread(buf: ptr, size: i64, count: i64, stream: ptr): i64
extern fn cruft_fwrite(buf: ptr, size: i64, count: i64, stream: ptr): i64
extern fn cruft_fseek(stream: ptr, offset: i64, whence: i32): i32
extern fn cruft_ftell(stream: ptr): i64
extern fn cruft_fclose(stream: ptr): i32
extern fn cruft_exists(path: ptr): i32

pub struct File
    handle: ptr
end

drop File(self: &File)
    unsafe
        if self.handle != null() then
            var rc: i32 = cruft_fclose(self.handle)
        end
    end
end

pub fn exists(path: str): bool ! {io}
    unsafe
        ret cruft_exists(path.data()) != 0
    end
end

pub fn open(path: str, mode: str): result.Result(File, i32) ! {io}
    unsafe
        var h: ptr = cruft_fopen(path.data(), mode.data())
        if h == null() then
            ret result.Err(1)
        end
        ret result.Ok(File(h))
    end
end

pub fn write_file(path: str, content: str): result.Result(i32, i32) ! {io}
    var file = open(path, "wb")?
    unsafe
        var n: i64 = content.byte_len()
        var got: i64 = cruft_fwrite(content.data(), 1, n, file.handle)
        if got != n then
            ret result.Err(3)
        end
    end
    ret result.Ok(0)
end

pub fn read_to_string(path: str): result.Result(String, i32) ! {io, alloc}
    var file = open(path, "rb")?
    unsafe
        var end_rc: i32 = cruft_fseek(file.handle, 0, 2)
        if end_rc != 0 then
            ret result.Err(2)
        end
        var n: i64 = cruft_ftell(file.handle)
        if n < 0 then
            ret result.Err(2)
        end
        var set_rc: i32 = cruft_fseek(file.handle, 0, 0)
        if set_rc != 0 then
            ret result.Err(2)
        end
        var buf: String = alloc_string(n)
        if n > 0 and buf.data() == null() then
            ret result.Err(4)
        end
        var got: i64 = cruft_fread(buf.data(), 1, n, file.handle)
        if got != n then
            ret result.Err(3)
        end
        ret result.Ok(buf)
    end
end
