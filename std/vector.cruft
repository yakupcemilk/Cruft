package vector

// Vector(T) is an owned buffer. The compiler allocates it with cruft_alloc,
// grows it with cruft_realloc, and releases it with cruft_free when the
// owner is dropped. `.at(i)` traps if i is outside [0, length).

pub trait Length
    fn len(self: &Self): i64
end

pub impl Length for Vector(i32)
    fn len(self: &Vector(i32)): i64
        ret self.length()
    end
end

pub fn sum_of(xs: Vector(i32)): i32
    ret xs.sum()
end

pub fn len(xs: Vector(i32)): i64
    ret xs.len()
end

pub fn at(xs: Vector(i32), i: i64): i32
    ret xs.at(i)
end
